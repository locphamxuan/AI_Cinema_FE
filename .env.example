# Where the browser sends API calls. Keep the default so requests stay same-origin
# and are proxied by the rewrite in next.config.ts.
NEXT_PUBLIC_API_URL=/api

# Backend the rewrite proxies to (NestJS, `npm run start:local` listens on 3001).
BACKEND_URL=http://localhost:3001

# Google Sign-In: the Web OAuth client ID (same as GOOGLE_WEB_CLIENT_ID of the backend).
# Leave empty to hide the "Sign in with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
